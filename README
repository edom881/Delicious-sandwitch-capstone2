(src/main/resources/delicious project_class_diagram..pdf)


🏗 Project Structure
src
├── main
│   └── java
│       └── com.pluralsight
│           ├── Application.java
│           │
│           ├── models
│           │   ├── Sandwich.java
│           │   ├── BLT.java
│           │   ├── PhillyCheeseSteak.java
│           │   ├── Drink.java
│           │   ├── Chips.java
│           │   ├── Order.java
│           │   ├── Topping.java
│           │   └── OrderItem.java
│           │
│           ├── ui
│           │   └── UserInterface.java
│           │
│           └── util
│               └── ReceiptWriter.java
│
└── test
    └── java
        └── com.pluralsight.models
            ├── SandwichTest.java
            ├── DrinkTest.java
            ├── ChipsTest.java
            └── OrderTest.java
